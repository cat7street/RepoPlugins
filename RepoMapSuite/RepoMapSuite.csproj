<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Version>1.0.1</Version>
    <Description>RepoMapSuite —— R.E.P.O. 地图增强三合一：Tab 地图队友/敌人图标 + 可缩放小地图 + 地图剩余价值 HUD</Description>
      <MenuLibDll Condition="'$(MenuLibDll)' == ''">MenuLib.dll</MenuLibDll>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameDir)\REPO_Data\Managed\Assembly-CSharp.dll</HintPath>
      <Publicize>true</Publicize>
    </Reference>
    <Reference Include="PhotonUnityNetworking">
      <HintPath>$(GameDir)\REPO_Data\Managed\PhotonUnityNetworking.dll</HintPath>
    </Reference>
    <Reference Include="PhotonRealtime">
      <HintPath>$(GameDir)\REPO_Data\Managed\PhotonRealtime.dll</HintPath>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(GameDir)\REPO_Data\Managed\Unity.TextMeshPro.dll</HintPath>
    </Reference>
    <!-- MenuLib.dll（软依赖，仅游戏内设置菜单用）：默认取项目目录，
         也可用 -p:MenuLibDll= 指定完整路径。https://thunderstore.io/c/repo/p/nickklmao/MenuLib/ -->
    <Reference Include="MenuLib">
      <HintPath>$(MenuLibDll)</HintPath>
      <Publicize>true</Publicize>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(GameDir)\REPO_Data\Managed\UnityEngine.UI.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
